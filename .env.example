# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=meterflow_iq
MONGODB_EVENTS_COLLECTION=meter_polling_events
MONGODB_SEED_RUNS_COLLECTION=seed_runs

# BigQuery
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=meterflow_iq_curated
GOOGLE_APPLICATION_CREDENTIALS=

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=METERFLOW_IQ
SNOWFLAKE_SCHEMA=CURATED

# Azure SQL
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# Azure Database for PostgreSQL
POSTGRES_WRITEBACK_ENABLED=false
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=meterflow_iq_app_state
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# Optional AI RCA Helper
AI_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_DEMO_PIN=
